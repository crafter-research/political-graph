---
import "../styles/graph.css";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Grafo Político Perú</title>
    <meta
      name="description"
      content="Mapa interactivo de relaciones entre políticos peruanos y casos de corrupción. 69 nodos, 37 conexiones, 112 documentos de respaldo."
    />
    <meta property="og:title" content="Grafo Político Perú" />
    <meta
      property="og:description"
      content="Mapa interactivo de relaciones entre políticos y casos de corrupción en Perú"
    />
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og-twitter.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <div class="intro" id="intro">
      <h1>Grafo Político</h1>
      <div class="sub">
        Mapa de relaciones entre <strong>políticos</strong> y <strong
          >casos de corrupción</strong
        > en Perú.<br />
        Nodos amarillos = personas. Nodos oscuros = casos.<br />
        Cada conexión está basada en investigaciones fiscales, juicios y data pública.
      </div>
      <div class="credit">Prototipo con data verificada</div>
      <div class="intro-actions">
        <button onclick="launch()">Explorar</button>
        <a href="https://github.com/crafter-research/political-graph" target="_blank" rel="noopener noreferrer" class="btn-secondary">GitHub</a>
      </div>
    </div>

    <div class="topbar">
      <div class="topbar-left">
        <div class="logo">Grafo Político</div>
      </div>
      <div class="filter-bar">
        <span class="filter-bar-label">Partido</span>
        <span class="chip-reset" onclick="resetPartyFilter()">&#10005;</span>
        <div id="party-chips" class="chip-inline"></div>
        <div class="filter-sep"></div>
        <span class="filter-bar-label">Vínculos</span>
        <div id="filter-container" class="chip-inline"></div>
      </div>
      <div class="search-wrap">
        <span class="search-icon">&#8981;</span>
        <input id="search" type="text" placeholder="Buscar político o caso..." />
      </div>
    </div>

    <div class="sidebar" id="sidebar">
      <h3>Nodos</h3>
      <div class="legend-item">
        <div class="legend-dot" style="background:var(--yellow)"></div>
        Político / Candidato
      </div>
      <div class="legend-item">
        <div class="legend-ring" style="border-color:#666"></div>
        Caso / Escándalo
      </div>

      <h3>Fuentes</h3>
      <div
        style="font-size:11px;color:var(--text-muted);line-height:1.6;padding:0 8px;"
      >
        Infogob &middot; JNE Declara+<br />
        Ojo Público (Lava Jato)<br />
        IDL Reporteros<br />
        Proética &middot; Convoca<br />
        datosabiertos.gob.pe<br />
        Poder Judicial &middot; OSCE
      </div>
    </div>

    <div class="info-panel" id="panel">
      <button class="close" onclick="closePanel()">&#10005;</button>
      <div id="panel-content"></div>
    </div>

    <div class="statsbar">
      <div>
        <span class="stat-val" id="s-pol">0</span><span class="stat-lbl"
          >Políticos</span
        >
      </div>
      <div>
        <span class="stat-val" id="s-cas">0</span><span class="stat-lbl"
          >Casos</span
        >
      </div>
      <div>
        <span class="stat-val" id="s-con">0</span><span class="stat-lbl"
          >Conexiones</span
        >
      </div>
      <div>
        <span class="stat-val" id="s-era">0</span><span class="stat-lbl"
          >Años cubiertos</span
        >
      </div>
      <div
        style="margin-left:auto;display:flex;align-items:center;gap:16px;color:var(--text-muted);font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:1px;"
      >
        <span>PROTOTIPO &middot; DATA ILUSTRATIVA BASADA EN FUENTES PÚBLICAS</span>
        <a href="https://github.com/crafter-research/political-graph" target="_blank" rel="noopener noreferrer" style="color:var(--text-muted);text-decoration:none;border-left:1px solid rgba(255,255,255,0.08);padding-left:16px;transition:color 0.15s;" onmouseover="this.style.color='#ffd23f'" onmouseout="this.style.color='var(--text-muted)'">GITHUB</a>
        <a href="/legal" style="color:var(--text-muted);text-decoration:none;border-left:1px solid rgba(255,255,255,0.08);padding-left:16px;transition:color 0.15s;" onmouseover="this.style.color='#ffd23f'" onmouseout="this.style.color='var(--text-muted)'">AVISO LEGAL</a>
      </div>
    </div>

    <svg id="canvas"></svg>

    <script>
      import "../scripts/graph";
    </script>
  </body>
</html>
